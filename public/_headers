# Read by Cloudflare Workers static assets; never served as a file there. It
# covers only the files served without running the Worker: the _next/static
# bundle and public/. Responses from the Next server get their headers from
# next.config.mjs. Copied from Cherrydock's move off Vercel (2026-09-24).

# Next's build output is content-hashed, so a URL never changes meaning:
# cache it for a year, as Vercel did. Without this every chunk goes out with
# `max-age=0, must-revalidate`, a round trip per file per page view.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The same security headers next.config.mjs sends, for static files too.
# HSTS matches what Vercel sent.
/*
  Strict-Transport-Security: max-age=63072000
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
