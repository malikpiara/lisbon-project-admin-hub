{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers through the OpenNext adapter, modelled on Cherrydock's
  // setup (moved from Vercel 2026-09-24). Lives in Malik's account (Workers
  // Paid). R2 bucket and D1 database created 2026-09-28; lp.lisboaux.com
  // cut over from Vercel 2026-10-04 (routes, below).
  "name": "lisbon-project",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // OpenNext calls back into this Worker for cache revalidation; the
      // service name must match the Worker's own name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lisbon-project",
    },
  ],
  // Next's caches (open-next.config.ts says what each one holds).
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "lisbon-project-opennext-cache",
    },
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "lisbon-project-tag-cache",
      "database_id": "7eba46a1-7661-46f7-be57-37f3bdf57c3d",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"],
    },
  ],
  // next/image optimization, through Cloudflare Images.
  "images": {
    "binding": "IMAGES",
  },
  // Run next to the database (Supabase, AWS eu-west-3 Paris) rather than next
  // to each visitor: every uncached request makes several DB round trips.
  "placement": {
    "region": "aws:eu-west-3",
  },
  "vars": {
    // payload.config.ts. A Worker can't touch a socket another request opened,
    // so the pg pool must never hand one over: close each connection after one
    // query (MAX_USES), and allow enough connections that no request ever
    // waits in the pool's queue (a waiter woken by another request's I/O hangs).
    "DATABASE_POOL_MAX_USES": "1",
    "DATABASE_POOL_MAX": "50",
    // Blocks the native Payload admin at /cms-admin, as VERCEL_ENV does on
    // Vercel (app/(payload)/cms-admin/[[...segments]]/page.tsx).
    "DEPLOY_ENV": "production",
  },
  // lp.lisboaux.com is a CNAME in the lisboaux.com zone (this account). A route
  // only acts on a Proxied record: while the record is DNS only it points at
  // Vercel and this route is inert, so the cutover (and its rollback) is the
  // record's proxy toggle, with no DNS gap. Same as Cherrydock's jobs.lisboaux.com.
  "routes": [{ "pattern": "lp.lisboaux.com/*", "zone_name": "lisboaux.com" }],
  "observability": {
    "enabled": true,
  },
  "workers_dev": true,
  "preview_urls": false,
  // PREVIEW WORKER (2026-10-07, Margin pilot): `--env preview` deploys a second
  // Worker, lisbon-project-preview, from a branch, for client review at
  // https://lisbon-project-preview.upfra-me.workers.dev. A Wrangler environment
  // rather than a Worker Preview: both OpenNext revalidation queues call the
  // site back through the WORKER_SELF_REFERENCE service binding, and a Worker
  // Preview's service bindings resolve to production, so a Preview would
  // refresh production's cache and leave its own stale. An environment is a
  // full deploy with its own cache bucket, tag database and Durable Object.
  // Bindings and vars are not inherited by environments, so they are restated.
  // Deploy with `pnpm run cf:deploy:preview` (scripts/cf.sh). No route: the
  // workers.dev URL is enough, and next.config.mjs marks it noindex.
  "env": {
    "preview": {
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "lisbon-project-preview" }],
      "r2_buckets": [
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "lisbon-project-opennext-cache-preview" },
      ],
      "d1_databases": [
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "lisbon-project-tag-cache-preview",
          "database_id": "98fe7a70-7447-4094-a685-cd87a7813432",
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
      "images": { "binding": "IMAGES" },
      "placement": { "region": "aws:eu-west-3" },
      "vars": {
        "DATABASE_POOL_MAX_USES": "1",
        "DATABASE_POOL_MAX": "50",
        "DEPLOY_ENV": "preview",
      },
      "observability": { "enabled": true },
      "workers_dev": true,
      "preview_urls": false,
      // Explicit: `routes` is one of the keys an environment INHERITS. Without
      // this, the first preview deploy (2026-10-07) tried to take production's
      // lp.lisboaux.com/* route; Cloudflare refused it as already in use.
      "routes": [],
    },
  },
}
